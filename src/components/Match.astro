---
const supportingLines = ['Chat first, reveal later.', 'Only real users, verified.', 'Avatar-powered live video.'];
---

<section aria-labelledby="match-heading" class="match">
  <div class="grid">
    <div class="left">
      <div class="panel copy-panel">
        <span class="age-marker">18+</span>
        <h2 id="match-heading" class="h2">Chemistry first. Match after.</h2>
        <p class="body-large">
          Talk as your avatar before you show your face. Every account is verified, so there's a real person on the
          other side.
        </p>
        <p class="taste-line caption1">Pick your top ten anime. We match on taste before anything else.</p>
        <a href="/match" class="link">See how Match works</a>
      </div>
      <div class="lines">
        {
          supportingLines.map((line) => (
            <div class="panel line-panel">
              <p class="caption1">{line}</p>
            </div>
          ))
        }
      </div>
    </div>

    <figure class="panel avatar-panel">
      <!--
        TODO: real avatar-frame media. Placeholder only — no fabricated
        screenshot until a real capture of the avatar-video-chat surface
        is provided.
      -->
      <div class="avatar-placeholder" aria-hidden="true">
        <div class="avatar-bg-pink"></div>
        <div class="avatar-bg-blue"></div>
      </div>
    </figure>
  </div>
</section>

<style>
  .match {
    padding: 24px;
    max-width: 1440px;
    margin: 0 auto;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .left {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .copy-panel {
    padding: 32px 24px;
    position: relative;
  }

  .age-marker {
    display: inline-block;
    border: 1px solid var(--accent);
    background-color: var(--accent);
    font-weight: 700;
    font-size: 13px;
    padding: 4px 10px;
    border-radius: 2px;
    margin-bottom: 16px;
    text-align: center;
    box-shadow: 0 10px 20px rgba(65, 25, 85, 1), 0 6px 6px rgba(65, 25, 85, 1);
  }

  .taste-line {
    margin-top: 16px;
    color: rgba(255, 255, 255, 0.7);
  }

  .link {
    display: inline-block;
    margin-top: 24px;
    color: var(--accent);
    font-weight: 700;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .lines {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .line-panel {
    padding: 20px;
    flex: 1 1 200px;
  }

  .avatar-panel {
    position: relative;
    min-height: 320px;
    margin: 0;
  }

  .avatar-placeholder {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: linear-gradient(200deg, rgba(192, 38, 211, 0.22), rgba(59, 130, 246, 0.12));
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .avatar-bg-pink,
  .avatar-bg-blue {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 500px;
    height: 420px;
    transform: rotate(-38.088deg);
    flex-shrink: 0;
    border-radius: 500px;
    filter: blur(60px);
    --orbit-radius: 120px;
  }
  .avatar-bg-pink {
    background: rgba(222, 11, 201, 0.3);
    animation: bg-circle-pink 24s linear infinite;
  }
  .avatar-bg-blue {
    background: rgba(18, 134, 240, 0.3);
    animation: bg-circle-blue 24s linear infinite;
  }

  @media (min-width: 900px) {
    .match {
      padding: 40px;
    }
    .grid {
      grid-template-columns: 1.3fr 1fr;
      gap: 24px;
    }
    .avatar-panel {
      margin-left: -16px;
    }
  }
</style>
