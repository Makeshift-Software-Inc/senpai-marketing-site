---
const year = new Date().getFullYear();

const columns = [
  {
    heading: 'App',
    links: [
      { href: '/match', label: 'Match' },
      { href: '/feeds', label: 'Feeds' },
      { href: '/create', label: 'Create' },
      { href: '/events', label: 'Events' },
      { href: '/download', label: 'Download' },
    ],
  },
  {
    heading: 'Company',
    links: [
      { href: '/careers', label: 'Careers' },
      { href: '/press', label: 'Press' },
      { href: 'mailto:team@senpaiapp.com', label: 'Contact' },
    ],
  },
  {
    heading: 'Build with us',
    links: [
      { href: 'https://gengado.com', label: 'Gengado' },
      { href: '/studio', label: 'Senpai Studio' },
      { href: '/creators', label: 'Creators' },
    ],
  },
  {
    heading: 'Legal',
    links: [
      { href: '/privacy-policy', label: 'Privacy Policy' },
      { href: '/terms-of-service', label: 'Terms of Service' },
      { href: '/cookie-policy', label: 'Cookie Policy' },
      { href: '/community-guidelines', label: 'Community Guidelines' },
      { href: '/child-safety', label: 'Child Safety' },
      { href: '/delete-account', label: 'Delete your account' },
      { href: '/ip-policy', label: 'IP policy' },
    ],
  },
];

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Makeshift Software Inc.',
  url: 'https://www.senpaiapp.com',
  sameAs: ['https://twitter.com/senpai_app', 'https://www.tiktok.com/@senpaiapp'],
};
---

<footer class="site-footer">
  <div class="cols">
    {
      columns.map((col) => (
        <nav aria-label={col.heading}>
          <h2 class="col-heading caption2">{col.heading}</h2>
          <ul>
            {col.links.map((link) => {
              const isExternal = link.href.includes('//');
              return (
                <li>
                  <a href={link.href} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener noreferrer' : undefined}>
                    {link.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      ))
    }
  </div>

  <!-- TODO: language switcher (<select> or hreflang links per spec §6.11) — deferred to the i18n phase, no locale routes exist yet -->
  <div class="bottom">
    <p class="caption2 legal-line">
      <a href="https://makeshift.software" target="_blank"> Makeshift Software Inc </a>. © {year}</p>
    </p>

    <div class="social-icons">
      <a href="https://twitter.com/senpai_app" aria-label="Senpai on X">
        <img src="/assets/images/twitter.svg" alt="" width={32} height={32} aria-hidden="true" />
      </a>
      <a href="https://www.tiktok.com/@senpaiapp" aria-label="Senpai on TikTok">
        <img src="/assets/images/tiktok.svg" alt="" width={32} height={32} aria-hidden="true" />
      </a>
    </div>
  </div>
</footer>

<script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} is:inline />

<style>
  .site-footer {
    padding: 40px 24px;
    max-width: 1440px;
    margin: 0 auto;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .col-heading {
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 12px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  ul a {
    color: #fff;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .bottom {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .legal-line {
    color: rgba(255, 255, 255, 0.6);
  }

  .social-icons {
    display: flex;
    gap: 8px;
  }
  .social-icons a {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 900px) {
    .cols {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
    .bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
