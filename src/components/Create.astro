---
const steps = [
  { label: 'Prompt', body: 'Type what you want to see.' },
  { label: 'Art', body: 'Senpai draws the scene.' },
  { label: 'Motion', body: 'Stills become video.' },
  { label: 'Short', body: 'A five to fifteen second anime clip.' },
  { label: 'Feed', body: 'Post it, and the fandom finds it.' },
];
---

<section aria-labelledby="create-heading" class="create">
  <div class="panel intro-panel">
    <h2 id="create-heading" class="h2">Make the episode you wanted to see.</h2>
    <p class="body-large">
      Describe a scene and Senpai builds it — art, motion, sound. Post it to the feed in the same session.
    </p>
  </div>

  <ol class="steps">
    {
      steps.map((step, i) => (
        <li class="panel step-panel">
          <span class="step-number" aria-hidden="true">
            {i + 1}
          </span>
          <span class="step-label title2">{step.label}</span>
          <p class="caption1">{step.body}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .create {
    padding: 24px;
    max-width: 1440px;
    margin: 0 auto;
  }

  .intro-panel {
    padding: 32px 24px;
  }

  .steps {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .step-panel {
    padding: 20px;
  }

  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 2px;
    background: linear-gradient(135deg, var(--grad-a), var(--grad-b));
    font-weight: 900;
    font-size: 20px;
    margin-bottom: 12px;
  }

  .step-label {
    display: block;
    margin-bottom: 4px;
    font-weight: 900;
  }

  @media (min-width: 900px) {
    .create {
      padding: 40px;
    }
    .steps {
      grid-template-columns: repeat(5, 1fr);
      gap: 16px;
    }
  }
</style>
