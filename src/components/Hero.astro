---
import FloatingCharacters from './FloatingCharacters.astro';

const APP_STORE_URL = 'https://apps.apple.com/us/app/senpai-dating-for-anime-fans/id6464066826';
---

<section aria-labelledby="hero-heading" class="hero">
  <div class="hero-grid">
    <div class="panel copy-panel">
      <h1 id="hero-heading" class="h1">Your people are here.</h1>

      <div class="quote-container">
        <blockquote class="sub body-large">
          Match, post, and make anime with fans who watch what you watch. Free on iPhone.
        </blockquote>
      </div>

      <a href={APP_STORE_URL} class="store-badge">
        <img
          src="/assets/images/appstore.png"
          alt="Download on the App Store"
          width={217}
          height={71}
          loading="eager"
        />
      </a>
    </div>

    <figure class="panel phone-panel">
      <!--
        TODO(founder): real hero clip. Per spec §12, this slot ships poster-only
        (or empty, absent a poster) until real in-app footage exists. Do not
        substitute stock/mockup footage or another product's video here.
        Target: 6-10s vertical loop, audio stripped, served from Bunny Stream.
      -->
      <div class="phone-placeholder" aria-hidden="true">
        <div class="phone-bg-pink"></div>
        <div class="phone-bg-blue"></div>
        <FloatingCharacters hideCharacters={true} />
        <FloatingCharacters hideCharacters={true} class="floating-characters-secondary" />
        <video
          class="onboarding-video"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster="/assets/images/senpai-onboarding-poster.jpg"
          width="468"
          height="906"
        >
          <source src="/assets/videos/senpai-onboarding-muted.webm" type="video/webm" />
        </video>
      </div>
      <img
        class="break-character"
        src="/assets/images/hero-character-right-upper-2.png"
        alt=""
        width={400}
        height={500}
      />
    </figure>
  </div>
</section>

<style>
  .hero {
    padding: 24px 24px 24px 24px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    max-width: 1440px;
    margin: 0 auto;
  }

  .copy-panel {
    padding: 40px 24px;
  }

  .quote-container {
    padding: 0;
  }

  @keyframes quote-entrance {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.94);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .sub.body-large {
    max-width: 42ch;
    padding: 20px 20px 20px 24px;
    border-left: 4px solid var(--accent);
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.7;
    margin: 24px 0 0;
    box-shadow:
      0 16px 40px rgba(192, 38, 211, 0.22),
      0 6px 16px rgba(59, 130, 246, 0.22);
    animation: quote-entrance 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
  }

  .store-badge {
    display: inline-block;
    margin-top: 32px;
  }
  .store-badge img {
    height: 48px;
    width: auto;
    display: block;
  }

  /*
    .phone-placeholder itself has no size of its own — it's position:absolute;
    inset:0, so it always exactly fills whatever box .phone-panel establishes.
    Making it responsive means giving .phone-panel real breakpoint-driven
    sizing instead of one flat min-height used at every width.
  */
  .phone-panel {
    position: relative;
    min-height: 360px;
    overflow: visible;
    margin: 0;
  }

  .phone-placeholder {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: linear-gradient(160deg, rgba(59, 130, 246, 0.18), rgba(192, 38, 211, 0.18));
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .phone-bg-pink,
  .phone-bg-blue {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 500px;
    height: 420px;
    transform: rotate(-38.088deg);
    flex-shrink: 0;
    border-radius: 500px;
    filter: blur(60px);
    --orbit-radius: 120px;
  }
  .phone-bg-pink {
    background: rgba(222, 11, 201, 0.3);
    animation: bg-circle-pink 24s linear infinite;
  }
  .phone-bg-blue {
    background: rgba(18, 134, 240, 0.3);
    animation: bg-circle-blue 24s linear infinite;
  }

  .phone-placeholder :global(.floating-characters) {
    z-index: 1;
  }

  /*
    Second FloatingCharacters instance, mirroring the original site's
    WifesRight treatment: same dot-circles/hearts styling as the :first-child
    instance (untouched — nothing in FloatingCharacters.astro changes), just
    shifted right as a single rigid unit via transform so it breaks off the
    right edge of .phone-placeholder (clipped by its overflow:hidden) instead
    of sitting exactly on top of the first instance. transform is applied
    after layout, so it doesn't affect the internal dot-circle viewport-
    centering calc()s at all — they still resolve correctly relative to this
    wrapper's original (pre-transform) box; the whole already-correct result
    just gets carried 65% of its own width to the right.
  */
  .phone-placeholder :global(.floating-characters-secondary) {
    transform: translate(108%, -48%);
  }

  .onboarding-video {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 55%;
    max-width: 220px;
    height: auto;
    z-index: 2;
    pointer-events: none;
  }

  .break-character {
    position: absolute;
    left: -24px;
    bottom: -44px;
    width: 140px;
    height: auto;
    z-index: 1;
  }

  @media (min-width: 900px) {
    .hero {
      padding: 40px 0 40px 40px;
    }
    .hero-grid {
      grid-template-columns: 1fr 1.1fr;
      align-items: stretch;
      max-width: none;
      margin: 0;
      padding-right: 0;
    }
    .copy-panel {
      padding: 64px 48px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      max-width: 640px;
    }
    .phone-panel {
      min-height: 480px;
      border-top-right-radius: 0;
      border-bottom-right-radius: 0;
    }
    .break-character {
      left: -48px;
      bottom: -58px;
      width: 200px;
    }
  }

  @media (min-width: 1600px) {
    .hero-grid {
      max-width: 1600px;
      margin: 0 auto;
      padding-right: 40px;
    }
    .phone-panel {
      min-height: 560px;
    }
  }
</style>
