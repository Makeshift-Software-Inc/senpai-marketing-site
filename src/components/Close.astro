---
const APP_STORE_URL = 'https://apps.apple.com/us/app/senpai-dating-for-anime-fans/id6464066826';
---

<section aria-labelledby="close-heading" class="close">
  <div class="panel panel--paper close-panel">
    <h2 id="close-heading" class="h2">Anime hits different together.</h2>
    <div class="actions">
      <img
        src="/assets/images/senpai-qr-code.png"
        alt="QR code linking to the Senpai App Store listing"
        width={120}
        height={120}
        class="qr hide-below-900"
      />
      <a href={APP_STORE_URL} class="store-badge">
        <img src="/assets/images/appstore.png" alt="Download on the App Store" width={217} height={71} />
      </a>
    </div>
  </div>
</section>

<style>
  .close {
    padding: 24px;
    max-width: 1440px;
    margin: 0 auto;
  }

  .close-panel {
    padding: 40px 24px;
    text-align: left;
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    margin-top: 24px;
  }

  .store-badge img {
    height: 48px;
    width: auto;
    display: block;
  }

  .qr {
    width: 96px;
    height: 96px;
  }

  .hide-below-900 {
    display: none;
  }

  @media (min-width: 900px) {
    .close {
      padding: 40px;
    }
    .close-panel {
      padding: 64px 48px;
    }
    .hide-below-900 {
      display: block;
    }
  }
</style>
